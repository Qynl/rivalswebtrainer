{
  "name": "rivals-offline-trainer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "preview": "node scripts/dev.mjs --preview",
    "test:browser": "playwright test",
    "test:soak": "node scripts/soak.mjs",
    "audit:visual": "node scripts/visual-audit.mjs",
    "audit:bots": "node scripts/bot-audit.mjs",
    "audit:arena": "node scripts/arena-audit.mjs",
    "audit:maps": "node scripts/audit-map-art.mjs",
    "server": "node server/index.js",
    "start": "SERVE_DIST=1 node server/index.js",
    "test:gloves": "npm run build && node --test tests/gloves.test.js tests/gloves-visuals.test.js tests/glove-experience.test.js && playwright test --config tests/gloves.playwright.config.js",
    "test:glove-endurance": "node scripts/glove-endurance.mjs"
  },
  "dependencies": {
    "@geckos.io/client": "^3.1.0",
    "peerjs": "^1.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.180.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.2.0",
    "peer": "^1.0.2",
    "vite": "^7.1.0"
  },
  "optionalDependencies": {
    "@geckos.io/server": "^3.1.0"
  }
}
